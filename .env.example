# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Resend API key for the contact form (https://resend.com/api-keys).
# Leave empty to log submissions to the server console instead of emailing them.
RESEND_API_KEY=

# Where contact form messages are sent. Defaults to the email in src/lib/site.ts.
CONTACT_TO_EMAIL=

# Sender shown on contact emails. Must use a domain verified in Resend.
# Example: UndaNova website <website@undanova.com>
# Defaults to Resend's test sender, which can only deliver to your Resend account's own email.
CONTACT_FROM_EMAIL=
